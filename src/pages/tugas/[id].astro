---
import Base from '../../layouts/Base.astro';
import { getApiBase } from '../../lib/server/env';
import { apiGet, apiPut, apiDelete, ApiError } from '../../lib/server/apiamis';
import { statusTugasMeta, statusMeta, canManageTugas, isAdmin, jenisLabel, normalizeRoleNames, asArray, wilayahNama, jenisLabel as jl, jenisShort } from '../../lib/survey';
import type { TugasSurvey, SurveyLokasi } from '../../lib/survey';

const id = Astro.params.id ?? '';
const base = getApiBase(Astro.locals as App.Locals);
const token = Astro.locals.token ?? null;
const user = Astro.locals.user ?? null;
const admin = canManageTugas(user);

let tugas: TugasSurvey | null = null;
let loadError = '';
let actionError = '';
let actionOk = '';

// Aksi admin: ubah status / ganti assignee / hapus
if (admin && Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const intent = String(fd.get('_intent') ?? '');
  try {
    if (intent === 'status') {
      const status = String(fd.get('status') ?? '').trim();
      if (!['ditugaskan', 'dikerjakan', 'selesai'].includes(status)) throw new Error('Status tidak valid.');
      await apiPut(base, `/survey-tugas/${id}`, token, { body: { status } });
      actionOk = 'Status tugas diperbarui.';
    } else if (intent === 'assignee') {
      const ids = fd.getAll('assignee_ids').filter((v): v is string => typeof v === 'string').map((v) => v.trim()).filter(Boolean);
      const tunggal = String(fd.get('assignee_id') ?? '').trim();
      const finalIds = ids.length > 0 ? ids : (tunggal ? [tunggal] : []);
      if (finalIds.length === 0) throw new Error('Pilih minimal satu penanggung jawab.');
      await apiPut(base, `/survey-tugas/${id}`, token, { body: { assignee_id: finalIds[0], assignee_ids: finalIds } });
      actionOk = 'Penanggung jawab diperbarui.';
    } else if (intent === 'hapus') {
      await apiDelete(base, `/survey-tugas/${id}`, token);
      return Astro.redirect('/tugas', 302);
    }
  } catch (e) {
    actionError = e instanceof ApiError ? e.message : e instanceof Error ? e.message : 'Aksi gagal.';
  }
}

try {
  const res = await apiGet<{ data?: TugasSurvey } | TugasSurvey>(base, `/survey-tugas/${id}`, token);
  tugas = (res as { data?: TugasSurvey }).data ?? (res as TugasSurvey);
} catch (e) {
  loadError = e instanceof Error ? e.message : 'Gagal memuat tugas.';
  if ((e as { status?: number })?.status === 404) loadError = 'Tugas tidak ditemukan.';
}

function roleNames(u: unknown): string {
  if (!u || typeof u !== 'object') return '';
  return normalizeRoleNames((u as { roles?: unknown }).roles).join(' · ').replace(/_/g, ' ');
}

// Survey terkait: coba filter tugas_id, fallback 100 terbaru + filter client
let surveys: SurveyLokasi[] = [];
if (tugas) {
  try {
    const res = await apiGet<unknown>(base, '/survey-lokasi', token, { tugas_id: id, per_page: 100 });
    const arr = Array.isArray(res) ? (res as SurveyLokasi[]) : asArray<SurveyLokasi>((res as { data?: unknown }).data ?? res);
    const matchId = (s: SurveyLokasi): boolean => String(s.tugas_id ?? s.tugas?.id ?? '') === String(id);
    const filtered = arr.filter(matchId);
    if (filtered.length > 0 || arr.length === 0) {
      surveys = filtered;
    } else if (arr.some((s) => s.tugas_id ?? s.tugas)) {
      // Backend mendukung filter (data membawa info tugas) tapi tak ada yang cocok.
      surveys = [];
    } else {
      // Backend mengabaikan query tugas_id → fallback: 100 terbaru lalu saring client.
      const all = await apiGet<unknown>(base, '/survey-lokasi', token, { per_page: 100 });
      const arr2 = Array.isArray(all) ? (all as SurveyLokasi[]) : asArray<SurveyLokasi>((all as { data?: unknown }).data ?? all);
      surveys = arr2.filter(matchId);
    }
  } catch {
    surveys = [];
  }
}

// Kandidat assignee untuk form admin
interface Kandidat { id: number | string; name?: string; email?: string; roles?: unknown }
let kandidat: Kandidat[] = [];
if (admin && tugas) {
  try {
    const res = await apiGet<unknown>(base, '/users', token, { per_page: 50 });
    const all = Array.isArray(res) ? (res as Kandidat[]) : asArray<Kandidat>((res as { data?: unknown }).data ?? res);
    const allowed = ['admin', 'tfl', 'pengawas', 'konsultan_pengawas', 'operator'];
    kandidat = all.filter((k) => {
      const have = new Set(normalizeRoleNames(k.roles));
      return allowed.some((r) => have.has(r));
    }).slice(0, 50);
  } catch {
    kandidat = [];
  }
}

const m = statusTugasMeta(tugas ? String(tugas.status) : undefined);
const tugasAnggota: Array<{ id: number | string; name?: string }> =
  (tugas?.assignees && tugas.assignees.length > 0)
    ? tugas.assignees
    : (tugas?.assignee ? [tugas.assignee] : []);
const canFill = tugas && String(tugas.status) !== 'selesai' && (isAdmin(user) || tugasAnggota.some((a) => String(a.id) === String((user as { id?: unknown })?.id)));

function fmtTanggal(v?: string | null): string {
  if (!v) return '-';
  const d = new Date(v.length <= 10 ? v + 'T00:00:00' : v);
  return Number.isNaN(d.getTime()) ? String(v) : d.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
}
---
<Base title={tugas ? tugas.judul : 'Detail Tugas'} active="tugas">
  <a href="/tugas" class="text-sm font-semibold text-orange-700 hover:underline">← Kembali ke daftar tugas</a>

  {actionOk && <div class="alert alert-ok mb-3 mt-2">{actionOk}</div>}
  {actionError && <div class="alert alert-error mb-3 mt-2">{actionError}</div>}

  {loadError || !tugas ? (
    <div class="card mt-2 text-center">
      <p class="text-sm text-slate-600">{loadError || 'Data tidak tersedia.'}</p>
      <a href="/tugas" class="btn btn-secondary mt-3">Kembali</a>
    </div>
  ) : (
    <>
      <div class="mt-2 flex flex-wrap items-start justify-between gap-2">
        <div class="min-w-0">
          <div class="flex flex-wrap items-center gap-2">
            <h1 class="page-title">{tugas.judul}</h1>
            <span class={`badge ${m.classes}`}>{m.label}</span>
          </div>
          <p class="page-sub">
            Tahun {tugas.tahun_anggaran ?? '-'}
            {tugas.jenis ? ` · ${jenisLabel(String(tugas.jenis))}` : ''}
            {tugas.sudah_disurvey ? ' · Sudah disurvey' : ''}
          </p>
        </div>
        {canFill && <a href={`/survey/baru?tugas_id=${tugas.id}`} class="btn btn-primary shrink-0">Isi Survey</a>}
      </div>

      <div class="card mt-3">
        <h2 class="mb-2 font-bold">Informasi Tugas</h2>
        <dl class="space-y-2 text-sm">
          {tugas.pekerjaan?.nama_paket && (
            <div><dt class="text-xs text-slate-500">Pekerjaan</dt><dd class="font-medium">{tugas.pekerjaan.nama_paket}</dd></div>
          )}
          <div class="grid grid-cols-2 gap-2">
            <div><dt class="text-xs text-slate-500">Kecamatan</dt><dd>{tugas.kecamatan ? wilayahNama({ nama: (tugas.kecamatan as { nama?: string }).nama }) !== '-' ? ((tugas.kecamatan as { nama?: string }).nama ?? '-') : '-' : '-'}</dd></div>
            <div><dt class="text-xs text-slate-500">Desa</dt><dd>{(tugas.desa as { nama?: string } | undefined)?.nama ?? '-'}</dd></div>
          </div>
          {tugas.lokasi_catatan && <div><dt class="text-xs text-slate-500">Catatan lokasi</dt><dd>{tugas.lokasi_catatan}</dd></div>}
          <div class="grid grid-cols-2 gap-2">
            <div class="col-span-2">
              <dt class="text-xs text-slate-500">Penanggung jawab{tugasAnggota.length > 1 ? ` (${tugasAnggota.length} orang, ★ = utama)` : ''}</dt>
              <dd class="mt-1 flex flex-wrap gap-1.5">
                {tugasAnggota.length === 0 ? (
                  <span class="text-slate-500">-</span>
                ) : (
                  tugasAnggota.map((a, i) => (
                    <span class={`inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-xs font-bold ${i === 0 ? 'bg-orange-100 text-orange-800' : 'bg-slate-100 text-slate-600'}`}>
                      {i === 0 ? '★ ' : ''}{a.name ?? `#${a.id}`}
                    </span>
                  ))
                )}
              </dd>
            </div>
            <div><dt class="text-xs text-slate-500">Batas waktu</dt><dd>{fmtTanggal(tugas.batas_waktu)}</dd></div>
          </div>
          <div><dt class="text-xs text-slate-500">Dibuat oleh</dt><dd>{tugas.creator?.name ?? '-'}</dd></div>
          {tugas.catatan_admin && <div><dt class="text-xs text-slate-500">Catatan admin</dt><dd class="rounded-lg bg-slate-50 p-2">{tugas.catatan_admin}</dd></div>}
        </dl>
      </div>

      <div class="mt-3">
        <div class="mb-2 flex items-center justify-between px-0.5">
          <h2 class="section-title">Survey terkait ({surveys.length})</h2>
          {canFill && <a href={`/survey/baru?tugas_id=${tugas.id}`} class="text-[13px] font-bold text-orange-600">+ Tambah</a>}
        </div>
        {surveys.length === 0 ? (
          <div class="card text-center">
            <p class="text-sm text-slate-500">Belum ada survey untuk tugas ini.</p>
            {canFill && <a href={`/survey/baru?tugas_id=${tugas.id}`} class="btn btn-primary mt-3 w-full sm:w-auto">Isi Survey</a>}
          </div>
        ) : (
          <ul class="space-y-2">
            {surveys.map((s) => {
              const sm = statusMeta(String(s.status));
              return (
                <li>
                  <a href={`/survey/${s.id}`} class="list-card">
                    {s.foto && s.foto.length > 0 ? (
                      <img src={s.foto[0].url} alt="" loading="lazy" class="h-11 w-11 shrink-0 rounded-xl border border-slate-200 object-cover" />
                    ) : (
                      <span class={`jenis-dot jenis-${String(s.jenis)}`}>{jenisShort(String(s.jenis))}</span>
                    )}
                    <span class="min-w-0 flex-1">
                      <span class="block truncate text-[15px] font-bold tracking-tight">{s.nama_lokasi}</span>
                      <span class="block truncate text-xs text-slate-500">{jl(String(s.jenis))} · {s.kecamatan?.nama ?? '-'} / {s.desa?.nama ?? '-'}</span>
                    </span>
                    <span class={`badge badge-dot ${sm.classes}`}>{sm.label}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        )}
      </div>

      {admin && (
        <>
          <form method="post" class="card mt-3">
            <h2 class="mb-2 font-bold">Kelola Tugas (Admin)</h2>
            <input type="hidden" name="_intent" value="status" />
            <label class="label" for="status">Status</label>
            <div class="flex gap-2">
              <select id="status" name="status" class="input flex-1">
                {['ditugaskan', 'dikerjakan', 'selesai'].map((v) => (
                  <option value={v} selected={String(tugas.status) === v}>{statusTugasMeta(v).label}</option>
                ))}
              </select>
              <button type="submit" class="btn btn-primary shrink-0">Simpan</button>
            </div>
          </form>

          <form method="post" class="card mt-3">
            <h2 class="mb-1 font-bold">Ganti Penanggung Jawab</h2>
            <p class="mb-2 text-xs text-slate-500">Centang satu atau lebih. Urutan = utama dulu.</p>
            <input type="hidden" name="_intent" value="assignee" />
            <div class="max-h-56 space-y-2 overflow-y-auto">
              {kandidat.length === 0 ? (
                <p class="text-sm text-slate-500">Tidak ada kandidat.</p>
              ) : (
                kandidat.map((k) => {
                  const kid = String(k.id);
                  const checked = tugasAnggota.some((a) => String(a.id) === kid);
                  return (
                    <label class="flex cursor-pointer items-center gap-2 rounded-xl border border-slate-200 p-2.5 hover:border-slate-300">
                      <input type="checkbox" name="assignee_ids" value={kid} class="h-5 w-5 shrink-0 accent-orange-600" checked={checked} />
                      <span class="min-w-0">
                        <span class="block truncate text-sm font-bold">{k.name ?? k.email ?? `Pengguna #${k.id}`}</span>
                        <span class="block truncate text-xs capitalize text-slate-500">{roleNames(k)}</span>
                      </span>
                    </label>
                  );
                })
              )}
            </div>
            <button type="submit" class="btn btn-secondary mt-2 w-full">Simpan penanggung jawab</button>
          </form>

          <form method="post" class="card mt-3" onsubmit="return confirm('Hapus tugas ini? Tindakan tidak bisa dibatalkan.')">
            <h2 class="mb-1 font-bold text-red-700">Zona berbahaya</h2>
            <p class="mb-2 text-sm text-slate-600">Tugas yang dihapus tidak bisa dikembalikan.</p>
            <input type="hidden" name="_intent" value="hapus" />
            <button type="submit" class="btn btn-danger w-full sm:w-auto">Hapus tugas</button>
          </form>
        </>
      )}
    </>
  )}
</Base>
