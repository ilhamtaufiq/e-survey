---
import Base from '../../layouts/Base.astro';
import { getApiBase } from '../../lib/server/env';
import { apiGet, apiPost, apiDelete, ApiError } from '../../lib/server/apiamis';
import { jenisLabel, statusMeta, canVerify, canEditSurvey, lampiranLabel, LAMPIRAN_LIST } from '../../lib/survey';
import type { SurveyLokasi } from '../../lib/survey';

const id = Astro.params.id ?? '';
const base = getApiBase(Astro.locals as App.Locals);
const token = Astro.locals.token ?? null;
const user = Astro.locals.user ?? null;

let survey: SurveyLokasi | null = null;
let loadError = '';
let actionError = '';
let actionOk = '';

// Aksi POST dari form di halaman ini (verifikasi / hapus)
if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const intent = String(fd.get('_intent') ?? '');
  try {
    if (intent === 'verifikasi') {
      const status = String(fd.get('status') ?? '');
      const catatan = String(fd.get('catatan_verifikasi') ?? '').trim();
      if (status !== 'diverifikasi' && status !== 'ditolak') throw new Error('Status verifikasi tidak valid.');
      await apiPost(base, `/survey-lokasi/${id}/verifikasi`, token, {
        body: { status, catatan_verifikasi: catatan || undefined },
      });
      actionOk = status === 'diverifikasi' ? 'Survey diverifikasi.' : 'Survey ditolak.';
    } else if (intent === 'hapus') {
      await apiDelete(base, `/survey-lokasi/${id}`, token);
      return Astro.redirect('/survey', 302);
    }
  } catch (e) {
    actionError = e instanceof ApiError ? e.message : e instanceof Error ? e.message : 'Aksi gagal.';
  }
}

try {
  const res = await apiGet<{ data?: SurveyLokasi } | SurveyLokasi>(base, `/survey-lokasi/${id}`, token);
  survey = (res as { data?: SurveyLokasi }).data ?? (res as SurveyLokasi);
} catch (e) {
  loadError = e instanceof Error ? e.message : 'Gagal memuat detail.';
  if ((e as { status?: number })?.status === 404) loadError = 'Data survey tidak ditemukan.';
}

const m = statusMeta(survey ? String(survey.status) : undefined);
const showVerify = survey && canVerify(user) && String(survey.status) === 'diajukan';
const showOwnerActions = survey && canEditSurvey(user, survey);
const detail = (survey?.detail ?? {}) as Record<string, unknown>;

// Kelompokkan lampiran per kategori checklist (frontmatter — markup tinggal render)
type LampiranFile = NonNullable<SurveyLokasi['foto']>[number];
const lampiranGroups: Array<{ key: string; label: string; files: LampiranFile[] }> = (() => {
  const map = new Map<string, LampiranFile[]>();
  for (const f of survey?.foto ?? []) {
    const key = ((f as LampiranFile).kategori || '').trim() || 'lainnya';
    if (!map.has(key)) map.set(key, []);
    map.get(key)!.push(f as LampiranFile);
  }
  const rank = (k: string) => {
    const i = LAMPIRAN_LIST.findIndex((l) => l.value === k);
    return i < 0 ? 99 : i;
  };
  return [...map.entries()]
    .sort(([a], [b]) => rank(a) - rank(b))
    .map(([key, files]) => ({
      key,
      label: key === 'lainnya' ? 'Lainnya' : lampiranLabel(key),
      files,
    }));
})();

const isImageName = (n?: string | null) => /\.(jpe?g|png|gif|webp|bmp)$/i.test(n ?? '');

