function detailDisplay(k: string, val: unknown): string {
  if (val === null || val === undefined || val === '') return '-';
  if (typeof val === 'boolean') return val ? 'Ada / lengkap' : '-';
  const s = String(val);
  return DETAIL_ENUM_LABELS[k]?.[s] ?? s;
}
---
<Base title={survey ? survey.nama_lokasi : 'Detail Survey'} active="survey">
  <a href="/survey" class="text-sm font-semibold text-orange-700 hover:underline">← Kembali ke daftar</a>

  {actionOk && <div class="mb-3 mt-2 rounded-xl bg-emerald-50 p-3 text-sm text-emerald-800">{actionOk}</div>}
  {actionError && <div class="mb-3 mt-2 rounded-xl bg-red-50 p-3 text-sm text-red-700">{actionError}</div>}

  {loadError || !survey ? (
    <div class="card mt-2 text-center">
      <p class="text-sm text-slate-600">{loadError || 'Data tidak tersedia.'}</p>
      <a href="/survey" class="btn btn-secondary mt-3">Kembali</a>
    </div>
  ) : (
    <>
      <div class="mt-2 flex flex-wrap items-start justify-between gap-2">
        <div>
          <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-xl font-bold sm:text-2xl">{survey.nama_lokasi}</h1>
            <span class={`badge ${m.classes}`}>{m.label}</span>
          </div>
          <p class="text-sm text-slate-600">
            {jenisLabel(String(survey.jenis))} · {survey.kecamatan?.nama ?? '-'} / {survey.desa?.nama ?? '-'}
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          {showOwnerActions && (
            <a href={`/survey/${survey.id}/edit`} class="btn btn-secondary ">Edit</a>
          )}
          <button type="button" id="btn-print" class="btn btn-secondary print:hidden">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect width="12" height="8" x="6" y="14"/></svg>
            Cetak / PDF
          </button>
        </div>
        <script is:inline>
          document.getElementById('btn-print')?.addEventListener('click', () => window.print());
        </script>
      </div>

      {survey.tugas && (
        <a href={`/tugas/${survey.tugas.id}`} class="list-card mt-3 border-orange-200 bg-orange-50/60">
          <span class="min-w-0 flex-1">
            <span class="block text-xs font-semibold uppercase tracking-wide text-orange-600">Tugas terkait</span>
            <span class="block truncate text-[15px] font-bold tracking-tight">{survey.tugas.judul}</span>
          </span>
          <span class="shrink-0 text-sm font-bold text-orange-700">Lihat →</span>
        </a>
      )}

      <div class="mt-3 grid gap-3 lg:grid-cols-2">
        <div class="card">
          <h2 class="mb-2 font-bold">Informasi</h2>
          <dl class="space-y-2 text-sm">
            <div><dt class="text-xs text-slate-500">Alamat</dt><dd>{survey.alamat || '-'}</dd></div>
            <div class="grid grid-cols-2 gap-2">
              <div><dt class="text-xs text-slate-500">Latitude</dt><dd class="font-mono">{survey.latitude ?? '-'}</dd></div>
              <div><dt class="text-xs text-slate-500">Longitude</dt><dd class="font-mono">{survey.longitude ?? '-'}</dd></div>
            </div>
            <div class="grid grid-cols-2 gap-2">
              <div><dt class="text-xs text-slate-500">Surveyor (pengisi)</dt><dd>{survey.surveyor?.name ?? '-'}</dd></div>
              <div><dt class="text-xs text-slate-500">Dibuat</dt><dd>{survey.created_at ? new Date(survey.created_at).toLocaleString('id-ID') : '-'}</dd></div>
            </div>
            <div><dt class="text-xs text-slate-500">Terakhir diubah</dt><dd>{survey.updated_at ? new Date(survey.updated_at).toLocaleString('id-ID') : '-'}</dd></div>
            {survey.verified_at && (
              <div><dt class="text-xs text-slate-500">Diverifikasi oleh</dt><dd>{survey.verified_by?.name ? `${survey.verified_by.name} · ${new Date(survey.verified_at).toLocaleString('id-ID')}` : new Date(survey.verified_at).toLocaleString('id-ID')}</dd></div>
            )}
            {survey.catatan_verifikasi && (
              <div><dt class="text-xs text-slate-500">Catatan verifikasi</dt><dd class="rounded-lg bg-slate-50 p-2">{survey.catatan_verifikasi}</dd></div>
            )}
          </dl>

          {Object.keys(detail).length > 0 && (
            <>
              <h3 class="mb-1 mt-4 font-bold">Detail teknis</h3>
              <dl class="grid grid-cols-1 gap-2 text-sm sm:grid-cols-2">
                {Object.entries(detail).map(([k, v]) => (
                  <div class="rounded-lg bg-slate-50 p-2">
                    <dt class="text-xs text-slate-500">{DETAIL_LABELS[k] ?? k}</dt>
                    <dd class="font-medium whitespace-pre-line">{detailDisplay(k, v)}</dd>
                  </div>
                ))}
              </dl>
            </>
          )}
        </div>

        <div class="card">
          <h2 class="mb-2 font-bold">Peta</h2>
          <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
          <div id="map-readonly" class="z-0 h-64 w-full rounded-xl border border-slate-200 sm:h-72"
            data-lat={survey.latitude ?? ''} data-lng={survey.longitude ?? ''} data-nama={survey.nama_lokasi}></div>
          {survey.latitude !== null && survey.latitude !== undefined && survey.longitude !== null && survey.longitude !== undefined && String(survey.latitude) !== '' && (
            <a
              href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${survey.latitude},${survey.longitude}`)}`}
              target="_blank"
              rel="noopener"
              class="btn btn-secondary mt-2 w-full"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              Buka di Google Maps
            </a>
          )}
          <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
          <script is:inline>
            (function () {
              function init() {
                if (typeof window.L === 'undefined') { setTimeout(init, 300); return; }
                var el = document.getElementById('map-readonly');
                if (!el) return;
                var lat = parseFloat(el.dataset.lat), lng = parseFloat(el.dataset.lng);
                if (!Number.isFinite(lat) || !Number.isFinite(lng)) {
                  el.innerHTML = '<p class="p-4 text-sm text-slate-500">Koordinat belum diisi.</p>';
                  return;
                }
                var map = window.L.map('map-readonly').setView([lat, lng], 15);
                window.L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                  maxZoom: 19, attribution: '&copy; OpenStreetMap',
                }).addTo(map);
                window.L.marker([lat, lng]).addTo(map).bindPopup(el.dataset.nama || 'Titik survey').openPopup();
                setTimeout(function () { map.invalidateSize(); }, 400);
              }
              init();
            })();
          </script>
        </div>
      </div>

      <div class="card mt-3">
        <h2 class="mb-1 font-bold">Lampiran ({survey.foto?.length ?? 0})</h2>
        <p class="mb-2 text-xs text-slate-500">Berkas per butir checklist dokumen &amp; foto.</p>
        {(survey.foto?.length ?? 0) === 0 ? (
          <p class="text-sm text-slate-500">Belum ada lampiran.</p>
        ) : (
          <div class="space-y-3">
            {lampiranGroups.map((g) => (
              <div>
                <p class="mb-1.5 text-xs font-bold uppercase tracking-wide text-slate-500">
                  {g.label} · {g.files.length}
                </p>
                <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
                  {g.files.map((f) => (
                    <a href={f.url} target="_blank" rel="noopener" class="group block overflow-hidden rounded-xl border border-slate-200">
                      {isImageName(f.name) ? (
                        <img src={f.url} alt={f.name ?? 'Lampiran survey'} loading="lazy" class="h-36 w-full object-cover transition group-hover:scale-105" />
                      ) : (
                        <span class="flex h-36 flex-col items-center justify-center gap-1 bg-slate-50 p-2 text-center">
                          <svg viewBox="0 0 24 24" class="h-7 w-7 text-slate-500" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/></svg>
                          <span class="line-clamp-2 text-xs font-medium text-slate-600">{f.name ?? 'Berkas'}</span>
                        </span>
                      )}
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </div>
        )}
      </div>

      {showVerify && (
        <form method="post" class="card mt-3 border-orange-200">
          <h2 class="mb-2 font-bold">Verifikasi (Admin)</h2>
          <input type="hidden" name="_intent" value="verifikasi" />
          <label class="label" for="catatan_verifikasi">Catatan</label>
          <textarea id="catatan_verifikasi" name="catatan_verifikasi" class="input" rows="2" placeholder="Catatan untuk surveyor…"></textarea>
          <div class="mt-2 flex gap-2">
            <button type="submit" name="status" value="diverifikasi" class="btn btn-primary flex-1">✓ Setujui</button>
            <button type="submit" name="status" value="ditolak" class="btn btn-danger flex-1">✕ Tolak</button>
          </div>
        </form>
      )}

      {showOwnerActions && (
        <form method="post" class="card mt-3" onsubmit="return confirm('Hapus survey ini? Tindakan tidak bisa dibatalkan.')">
          <h2 class="mb-1 font-bold text-red-700">Zona berbahaya</h2>
          <p class="mb-2 text-sm text-slate-600">Survey yang masih <b>diajukan</b> bisa dihapus pemilik/admin.</p>
          <input type="hidden" name="_intent" value="hapus" />
          <button type="submit" class="btn btn-danger w-full sm:w-auto">Hapus survey</button>
        </form>
      )}
    </>
  )}
</Base>
