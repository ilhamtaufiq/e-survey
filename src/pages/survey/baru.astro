---
import Base from '../../layouts/Base.astro';
import { z } from 'zod';
import { getApiBase } from '../../lib/server/env';
import { apiGet, apiPost, ApiError } from '../../lib/server/apiamis';
import { JENIS_LIST, LAMPIRAN_LIST } from '../../lib/survey';
import type { TugasSurvey } from '../../lib/survey';

const base = getApiBase(Astro.locals as App.Locals);
const token = Astro.locals.token ?? null;

// Dukungan ?tugas_id=: ambil info tugas untuk default form + otorisasi
const queryTugasId = new URL(Astro.request.url).searchParams.get('tugas_id') ?? '';
let tugas: TugasSurvey | null = null;
let tugasError = '';
async function loadTugas(tid: string): Promise<void> {
  if (!tid) return;
  try {
    const res = await apiGet<{ data?: TugasSurvey } | TugasSurvey>(base, `/survey-tugas/${tid}`, token);
    tugas = (res as { data?: TugasSurvey }).data ?? (res as TugasSurvey);
  } catch {
    tugas = null;
    tugasError = 'Tugas tidak ditemukan / bukan hak Anda.';
  }
}

const SurveySchema = z.object({
  jenis: z.enum(['spam_perpipaan', 'spam_pengeboran', 'mck_individu', 'mck_komunal'], { message: 'Jenis survey wajib dipilih' }),
  nama_lokasi: z.string().min(3, 'Nama lokasi minimal 3 karakter').max(200),
  kecamatan_id: z.string().min(1, 'Kecamatan wajib dipilih'),
  desa_id: z.string().min(1, 'Desa wajib dipilih'),
  alamat: z.string().max(500).optional().default(''),
  latitude: z.string().optional().default(''),
  longitude: z.string().optional().default(''),
});

const DETAIL_KEYS = [
  'sumber_air', 'debit_liter_detik', 'jumlah_kk', 'kebutuhan', 'kondisi_existing',
  'tipe', 'jumlah_bilik', 'kedalaman_rencana_m', 'kondisi_tanah', 'akses_alat',
  // Formulir SPAM Perdesaan
  'tanggal_survei', 'nama_surveyor_tim', 'dusun', 'rt', 'rw',
  'broncaptering_lat', 'broncaptering_lng', 'broncaptering_elevasi',
  'reservoir_lat', 'reservoir_lng', 'reservoir_elevasi',
  'sumber_air_jenis', 'debit_hujan_lps', 'debit_hujan_bulan',
  'debit_kemarau_lps', 'debit_kemarau_bulan', 'kejernihan', 'bau_rasa', 'ph',
  'lahan_broncaptering_status', 'elevasi_kelayakan', 'jarak_sumber_reservoir_m',
  'reservoir_lahan_status', 'reservoir_lahan_lainnya', 'topografi',
  'selisih_elevasi_m', 'akses_material',
  'pipa_trunk_m', 'pipa_cabang_m', 'lintas_tanah_m', 'lintas_paving_m',
  'lintas_aspal_m', 'lintas_sungai_titik', 'lintas_sungai_lebar_m',
  'washout_titik', 'air_valve_titik',
  'total_jiwa', 'sumber_eksisting', 'kesediaan_pelanggan', 'kesediaan_persen',
  'kesediaan_iuran', 'tarif_perkiraan', 'bnba',
  // Formulir SPAM Sumur Bor
  'sumur_lat', 'sumur_lng', 'sumur_elevasi', 'ku1_lat', 'ku1_lng',
  'ku2_lat', 'ku2_lng', 'lahan_sumur_status', 'lahan_sumur_lainnya',
  'lahan_panjang_m', 'lahan_lebar_m', 'akuifer_kedalaman_m',
  'sumur_warga_kedalaman_m', 'air_warga_kualitas', 'listrik_jarak_m',
  'listrik_daya', 'akses_rig', 'tanah_menara', 'menara_tinggi',
  'toren_kapasitas', 'toren_kapasitas_lainnya', 'toren_bahan',
  'jumlah_ku_titik', 'ku_rincian', 'kran_per_titik', 'drainase',
  'kesediaan_kelompok', 'iuran_listrik',
  // Formulir MCK
  'mck_lat', 'mck_lng', 'mck_elevasi',
  'jumlah_pintu', 'jumlah_pintu_lainnya',
  'bilik1_fungsi', 'bilik2_fungsi', 'bilik3_fungsi', 'bilik4_fungsi',
  'kloset_jenis', 'wudhu_ada', 'wudhu_keran', 'wudhu_desain',
  'mck_sumber_air', 'toren_menara', 'toren_dak',
  'septik_jenis', 'septik_bio_kapasitas_m3', 'septik_bio_pengguna',
  'septik_panjang_m', 'septik_lebar_m', 'septik_dalam_m',
  'resapan_jenis', 'resapan_diameter_m', 'resapan_dalam_m',
  'tanah_jenis', 'muka_air_tanah_m', 'jarak_septik_sumur_m',
  'nama_kk', 'anggota_jiwa', 'status_ekonomi',
  'target_warga_kk', 'target_warga_jiwa', 'target_jamaah', 'target_santri',
  'pengelola',
] as const;

let formError = '';
let fieldErrors: Record<string, string[]> = {};
// Nilai sebelumnya agar form tidak kosong saat validasi gagal
let prev: Record<string, string> = {};
// Langkah wizard yang harus dibuka setelah render (mis. 'map' saat koordinat kosong)
let gotoStep = '';
const wasPost = Astro.request.method === 'POST';

if (Astro.request.method === 'GET' && queryTugasId) {
  await loadTugas(queryTugasId);
  if (tugas) {
    if (tugas.jenis) prev.jenis = String(tugas.jenis);
    const namaDefault = tugas.pekerjaan?.nama_paket || tugas.judul || '';
    if (namaDefault) prev.nama_lokasi = String(namaDefault);
    if (tugas.kecamatan_id) prev.kecamatan_id = String(tugas.kecamatan_id);
    if (tugas.desa_id) prev.desa_id = String(tugas.desa_id);
    prev.tugas_id = String(tugas.id);
  } else if (tugasError) {
    formError = tugasError;
  }
}

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const raw: Record<string, string> = {};
  for (const [k, v] of fd.entries()) {
    if (typeof v === 'string' && !(k in raw)) raw[k] = v;
  }
  prev = raw;
  const tugasId = (raw.tugas_id ?? '').trim();
  if (tugasId) {
    await loadTugas(tugasId);
    if (!tugas) {
      formError = tugasError || 'Tugas tidak ditemukan / bukan hak Anda.';
    }
  }

  const parsed = formError
    ? null
    : SurveySchema.safeParse({
    jenis: raw.jenis ?? '',
    nama_lokasi: (raw.nama_lokasi ?? '').trim(),
    kecamatan_id: raw.kecamatan_id ?? '',
    desa_id: raw.desa_id ?? '',
    alamat: (raw.alamat ?? '').trim(),
    latitude: (raw.latitude ?? '').trim(),
    longitude: (raw.longitude ?? '').trim(),
  });

  if (parsed === null) {
    // formError sudah diisi (tugas tidak valid) — jangan submit.
  } else if (!parsed.success) {
    fieldErrors = parsed.error.flatten().fieldErrors as Record<string, string[]>;
    formError = 'Periksa kembali isian form yang ditandai.';
  } else {
    // Wajib minimal satu titik koordinat (peta utama atau salah satu tapak).
    const KOORD_PAIRS = [
      ['latitude', 'longitude'],
      ['broncaptering_lat', 'broncaptering_lng'],
      ['reservoir_lat', 'reservoir_lng'],
      ['sumur_lat', 'sumur_lng'],
      ['ku1_lat', 'ku1_lng'],
      ['ku2_lat', 'ku2_lng'],
      ['mck_lat', 'mck_lng'],
    ] as const;
    const hasKoord = KOORD_PAIRS.some(([a, b]) => (raw[a] ?? '').trim() !== '' && (raw[b] ?? '').trim() !== '');
    if (!hasKoord) {
      formError = 'Isi minimal satu titik koordinat: tandai peta utama (bagian 2) atau isi koordinat tapak.';
      gotoStep = 'map';
    } else {
    const detail: Record<string, string | boolean> = {};
    for (const k of DETAIL_KEYS) {
      const v = (raw[k] ?? '').trim();
      if (v !== '') detail[k] = v;
    }
    // Lampiran per butir checklist (satu butir bisa beberapa berkas).
    const lampiranFiles: Array<{ file: File; kategori: string }> = [];
    for (const l of LAMPIRAN_LIST) {
      for (const f of fd.getAll(`lampiran-${l.value}`)) {
        if (f instanceof File && f.size > 0) lampiranFiles.push({ file: f, kategori: l.value });
      }
    }
    // Kompatibilitas: input generik lama bernama `foto` (tanpa kategori).
    for (const f of fd.getAll('foto')) {
      if (f instanceof File && f.size > 0) lampiranFiles.push({ file: f, kategori: '' });
    }

    try {
      let createdId: string | null = null;
      if (lampiranFiles.length > 0) {
        // Multipart: field + foto[] + foto_kategori[] sejajar
        const out = new FormData();
        out.set('jenis', parsed.data.jenis);
        out.set('nama_lokasi', parsed.data.nama_lokasi);
        out.set('kecamatan_id', parsed.data.kecamatan_id);
        out.set('desa_id', parsed.data.desa_id);
        if (parsed.data.alamat) out.set('alamat', parsed.data.alamat);
        if (parsed.data.latitude) out.set('latitude', parsed.data.latitude);
        if (parsed.data.longitude) out.set('longitude', parsed.data.longitude);
        out.set('detail', JSON.stringify(detail));
        if (tugasId && tugas) out.set('tugas_id', String(tugas.id));
        for (const { file, kategori } of lampiranFiles) {
          out.append('foto', file, file.name || 'lampiran');
          out.append('foto_kategori', kategori);
        }
        const res = await apiPost<{ data?: { id?: unknown }; id?: unknown }>(base, '/survey-lokasi', token, { formData: out });
        const d = res as { data?: { id?: unknown }; id?: unknown };
        createdId = String(d?.data?.id ?? d?.id ?? '');
      } else {
        const res = await apiPost<{ data?: { id?: unknown }; id?: unknown }>(
          base,
          '/survey-lokasi',
          token,
          {
            body: {
              jenis: parsed.data.jenis,
              nama_lokasi: parsed.data.nama_lokasi,
              kecamatan_id: parsed.data.kecamatan_id,
              desa_id: parsed.data.desa_id,
              alamat: parsed.data.alamat || undefined,
              latitude: parsed.data.latitude || undefined,
              longitude: parsed.data.longitude || undefined,
              detail,
              ...(tugasId && tugas ? { tugas_id: tugas.id } : {}),
            },
          },
        );
        createdId = String(res?.data?.id ?? res?.id ?? '');
      }
      if (createdId) return Astro.redirect(`/survey/${createdId}`, 302);
      return Astro.redirect('/survey', 302);
    } catch (e) {
      if (e instanceof ApiError) {
        formError = e.message;
        if (e.errors) fieldErrors = e.errors;
      } else {
        formError = e instanceof Error ? e.message : 'Gagal menyimpan survey.';
      }
    }
    } // end: koordinat terisi
  }
}

const err = (name: string): string => fieldErrors[name]?.[0] ?? '';
---
<Base title="Survey Baru" active="baru">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <div class="mb-4">
    <h1 class="text-xl font-bold sm:text-2xl">Survey Baru</h1>
    <p class="text-sm text-slate-600">Isi data lokasi di lapangan. Jika sinyal hilang, pakai tombol <b>Simpan Draft Offline</b>.</p>
  </div>

  <div id="offline-banner" class="mb-3 hidden rounded-xl bg-amber-50 p-3 text-sm text-amber-800">
    Anda sedang <b>offline</b>. Isian bisa disimpan sebagai draft di perangkat, lalu disinkronkan saat online.
  </div>

  {formError && (
    <div class="mb-3 rounded-xl bg-red-50 p-3 text-sm text-red-700">{formError}</div>
  )}

  {(tugas || prev.tugas_id) && (
    <div class="mb-3 rounded-xl bg-orange-50 p-3 text-sm text-orange-800">
      Survey untuk tugas: <b>{tugas?.judul ?? `#${prev.tugas_id}`}</b>
      {tugas && (tugas.assignees?.length ? ` · Tim: ${tugas.assignees.map((a) => a.name ?? `#${a.id}`).join(', ')}` : tugas.assignee?.name ? ` · Penanggung jawab: ${tugas.assignee.name}` : '')}
    </div>
  )}

  <form id="survey-form" method="post" enctype="multipart/form-data" class="space-y-4" data-was-post={wasPost ? '1' : ''} data-goto={gotoStep || undefined}>
    <div id="wizard-nav" class="card mb-3 !p-3 sm:!p-4">
      <div class="flex items-baseline justify-between gap-2">
        <p class="text-sm font-bold">Langkah <span id="wizard-count">1/1</span> · <span id="wizard-title">—</span></p>
        <p class="shrink-0 text-xs font-semibold text-slate-500"><span id="wizard-filled">0</span>/<span id="wizard-total">0</span> terisi</p>
      </div>
      <div class="mt-2 h-2 overflow-hidden rounded-full bg-slate-100">
        <div id="wizard-bar" class="h-full w-0 rounded-full bg-orange-600 transition-all"></div>
      </div>
      <div id="wizard-restore" class="hidden mt-2 rounded-xl bg-orange-50 p-2.5 text-[13px] text-orange-800">
        Ada isian tersimpan di perangkat. <button type="button" id="wizard-restore-yes" class="font-bold underline">Lanjutkan</button> · <button type="button" id="wizard-restore-no" class="underline">Buang</button>
      </div>
    </div>
    {(prev.tugas_id || queryTugasId) && <input type="hidden" name="tugas_id" value={prev.tugas_id ?? queryTugasId} />}
    <div class="card">
      <h2 class="mb-2 font-bold">1. Jenis Survey</h2>
      <div class="grid grid-cols-1 gap-2 sm:grid-cols-2" role="radiogroup" aria-label="Jenis survey">
        {JENIS_LIST.map((j, i) => (
          <label class={`cursor-pointer rounded-2xl border-2 p-3 transition ${ (prev.jenis ?? 'spam_perpipaan') === j.value ? 'border-orange-600 bg-orange-50' : 'border-slate-200 hover:border-slate-300' }`}>
            <input type="radio" name="jenis" value={j.value} class="sr-only jenis-radio" checked={(prev.jenis ?? 'spam_perpipaan') === j.value} />
            <div class="font-bold">{j.label}</div>
            <div class="text-xs text-slate-600">{j.deskripsi}</div>
          </label>
        ))}
      </div>
      {err('jenis') && <p class="mt-1 text-xs text-red-600">{err('jenis')}</p>}
    </div>

    <div class="card">
      <h2 class="mb-2 font-bold">2. Lokasi</h2>
      <div class="grid gap-3 sm:grid-cols-2">
        <div class="sm:col-span-2">
          <label class="label" for="nama_lokasi">Nama lokasi *</label>
          <input id="nama_lokasi" name="nama_lokasi" class="input" required minlength="3" maxlength="200" value={prev.nama_lokasi ?? ''} placeholder="cth: SPAM Desa Sukamaju / Sumur Bor Kp. Cibulakan" />
          {err('nama_lokasi') && <p class="mt-1 text-xs text-red-600">{err('nama_lokasi')}</p>}
        </div>
        <div>
          <label class="label" for="kecamatan_id">Kecamatan *</label>
          <select id="kecamatan_id" name="kecamatan_id" class="input" required data-prev={prev.kecamatan_id ?? ''}>
            <option value="">— Memuat… —</option>
          </select>
          {err('kecamatan_id') && <p class="mt-1 text-xs text-red-600">{err('kecamatan_id')}</p>}
        </div>
        <div>
          <label class="label" for="desa_id">Desa *</label>
          <select id="desa_id" name="desa_id" class="input" required data-prev={prev.desa_id ?? ''}>
            <option value="">— Pilih kecamatan dulu —</option>
          </select>
          {err('desa_id') && <p class="mt-1 text-xs text-red-600">{err('desa_id')}</p>}
        </div>
        <div class="sm:col-span-2">
          <label class="label" for="alamat">Alamat / patokan</label>
          <textarea id="alamat" name="alamat" class="input" rows="2" placeholder="Nama jalan, RT/RW, patokan…">{prev.alamat ?? ''}</textarea>
        </div>
      </div>

      <div class="mt-3">
        <div class="mb-1 flex items-center justify-between">
          <label class="label !mb-0">Titik koordinat</label>
          <button type="button" id="btn-gps" class="btn btn-secondary !min-h-11 !px-3 !text-[13px]">Pakai GPS saya</button>
        </div>
        <div id="map" class="z-0 h-64 w-full rounded-xl border border-slate-300 sm:h-80"></div>
        <p class="mt-1 text-xs text-slate-500">Ketuk peta untuk menandai titik, atau geser pin. Default: Cianjur.</p>
        <div class="mt-2 grid grid-cols-2 gap-2">
          <div>
            <label class="label" for="latitude">Latitude</label>
            <input id="latitude" name="latitude" class="input font-mono" inputmode="decimal" value={prev.latitude ?? ''} placeholder="-6.820…" />
          </div>
          <div>
            <label class="label" for="longitude">Longitude</label>
            <input id="longitude" name="longitude" class="input font-mono" inputmode="decimal" value={prev.longitude ?? ''} placeholder="107.140…" />
          </div>
        </div>
      </div>
    </div>

    <div class="card">
      <h2 class="mb-2 font-bold">3. Detail Teknis</h2>

      <div id="info-survei" class="mb-4 rounded-xl bg-slate-50 p-3">
        <h3 class="mb-2 text-sm font-bold text-orange-700">Informasi survei</h3>
        <div class="grid gap-3 sm:grid-cols-2">
          <div>
            <label class="label" for="tanggal_survei">Tanggal survei</label>
            <input id="tanggal_survei" name="tanggal_survei" type="date" class="input" value={prev.tanggal_survei ?? ''} />
          </div>
          <div>
            <label class="label" for="nama_surveyor_tim">Nama surveyor / tim</label>
            <input id="nama_surveyor_tim" name="nama_surveyor_tim" class="input" value={prev.nama_surveyor_tim ?? ''} placeholder="cth: Tim TFL Cianjur" />
          </div>
          <div>
            <label class="label" for="dusun">Dusun</label>
            <input id="dusun" name="dusun" class="input" value={prev.dusun ?? ''} placeholder="cth: Kp. Cibulakan" />
          </div>
          <div class="grid grid-cols-2 gap-2">
            <div>
              <label class="label" for="rt">RT</label>
              <input id="rt" name="rt" class="input" value={prev.rt ?? ''} placeholder="001" />
            </div>
            <div>
              <label class="label" for="rw">RW</label>
              <input id="rw" name="rw" class="input" value={prev.rw ?? ''} placeholder="005" />
            </div>
          </div>
        </div>
      </div>

      <div class="detail-group space-y-4" data-jenis="spam_perpipaan">

        <div>
          <div class="mb-2">
            <h3 class="text-sm font-bold text-orange-700">B. Koordinat tapak (GPS)</h3>
            <p class="mt-0.5 text-xs text-slate-500">Opsional — isi salah satu atau keduanya sesuai kondisi lapangan.</p>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            <div class="rounded-xl bg-slate-50 p-3">
              <div class="mb-2 flex items-center justify-between gap-2">
                <p class="text-xs font-bold text-slate-600">Rencana Broncaptering</p>
                <button type="button" class="btn btn-secondary !min-h-11 !px-3 !text-[13px] btn-salin-koord" data-target="broncaptering">Salin dari peta</button>
              </div>
              <div class="grid grid-cols-3 gap-2">
                <div><label class="label" for="broncaptering_lat">Lat</label><input id="broncaptering_lat" name="broncaptering_lat" class="input font-mono" inputmode="decimal" value={prev.broncaptering_lat ?? ''} /></div>
                <div><label class="label" for="broncaptering_lng">Long</label><input id="broncaptering_lng" name="broncaptering_lng" class="input font-mono" inputmode="decimal" value={prev.broncaptering_lng ?? ''} /></div>
                <div>
                  <label class="label" for="broncaptering_elevasi">Elev (m)</label>
                  <div class="flex gap-1">
                    <input id="broncaptering_elevasi" name="broncaptering_elevasi" class="input min-w-0 flex-1 font-mono" inputmode="decimal" value={prev.broncaptering_elevasi ?? ''} />
                    <button type="button" class="btn btn-secondary shrink-0 !min-h-11 !px-3 !text-[13px] btn-elev-auto" data-target="broncaptering" title="Ambil elevasi otomatis dari peta">Auto</button>
                  </div>
                </div>
              </div>
            </div>
            <div class="rounded-xl bg-slate-50 p-3">
              <div class="mb-2 flex items-center justify-between gap-2">
                <p class="text-xs font-bold text-slate-600">Rencana Reservoir</p>
                <button type="button" class="btn btn-secondary !min-h-11 !px-3 !text-[13px] btn-salin-koord" data-target="reservoir">Salin dari peta</button>
              </div>
              <div class="grid grid-cols-3 gap-2">
                <div><label class="label" for="reservoir_lat">Lat</label><input id="reservoir_lat" name="reservoir_lat" class="input font-mono" inputmode="decimal" value={prev.reservoir_lat ?? ''} /></div>
                <div><label class="label" for="reservoir_lng">Long</label><input id="reservoir_lng" name="reservoir_lng" class="input font-mono" inputmode="decimal" value={prev.reservoir_lng ?? ''} /></div>
                <div>
                  <label class="label" for="reservoir_elevasi">Elev (m)</label>
                  <div class="flex gap-1">
                    <input id="reservoir_elevasi" name="reservoir_elevasi" class="input min-w-0 flex-1 font-mono" inputmode="decimal" value={prev.reservoir_elevasi ?? ''} />
                    <button type="button" class="btn btn-secondary shrink-0 !min-h-11 !px-3 !text-[13px] btn-elev-auto" data-target="reservoir" title="Ambil elevasi otomatis dari peta">Auto</button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div>
          <h3 class="mb-2 text-sm font-bold text-orange-700">C. Sumber air baku (broncaptering)</h3>
          <div class="grid gap-3 sm:grid-cols-2">
            <div>
              <label class="label" for="sumber_air_jenis">Jenis sumber</label>
              <select id="sumber_air_jenis" name="sumber_air_jenis" class="input">
                <option value="">— Pilih —</option>
                {[
                  ['mata_air_terjun', 'Mata air terjun / grojogan'],
                  ['rembesan', 'Mata air rembesan (seepage)'],
                  ['umbul', 'Mata air umbul (spring)'],
                  ['sungai', 'Sungai'],
                  ['sumur_bor', 'Sumur bor'],
                ].map(([v, l]) => (<option value={v} selected={prev.sumber_air_jenis === v}>{l}</option>))}
              </select>
            </div>
            <div>
              <label class="label" for="jarak_sumber_reservoir_m">Jarak sumber → reservoir (m)</label>
