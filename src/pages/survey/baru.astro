  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script>
  // Notifikasi tak memblokir (lihat esNotify di Base.astro). Fallback ke alert bila layout belum siap.
  function notify(msg: string, tone: string = 'error') {
    if (typeof window.esNotify === 'function') window.esNotify(msg, tone);
    else alert(msg);
  }
    import { saveDraft } from '../../scripts/offline-queue.js';

    const $ = (id) => document.getElementById(id);
    const form = $('survey-form');

    // ── Status online ──
    const banner = $('offline-banner');
    const paintOnline = () => banner.classList.toggle('hidden', navigator.onLine);
    window.addEventListener('online', paintOnline);
    window.addEventListener('offline', paintOnline);
    paintOnline();

    // ── Jenis: tampilkan grup detail yg aktif ──
    const radios = Array.from(document.querySelectorAll('.jenis-radio'));
    const groups = Array.from(document.querySelectorAll('.detail-group'));
    function paintJenis() {
      const active = (document.querySelector('.jenis-radio:checked') || {}).value || 'spam_perpipaan';
      groups.forEach((g) => {
        const on = (g.dataset.jenis || '').split(' ').includes(active);
        g.classList.toggle('hidden', !on);
        g.querySelectorAll('input, select, textarea').forEach((el) => { el.disabled = !on; });
      });
      document.querySelectorAll('.lampiran-item').forEach((el) => {
        const on = (el.dataset.jenis || '').split(' ').includes(active);
        el.classList.toggle('hidden', !on);
        el.querySelectorAll('input').forEach((i) => { i.disabled = !on; });
      });
      document.querySelectorAll('[data-mck-untuk]').forEach((el) => {
        const on = (el.dataset.mckUntuk || '') === active;
        el.classList.toggle('hidden', !on);
        el.querySelectorAll('input, select, textarea').forEach((i) => { i.disabled = !on; });
      });
      document.querySelectorAll('.mck-jenis-label').forEach((el) => {
        el.textContent = active === 'mck_individu' ? 'MCK Individu' : 'MCK Komunal';
      });
      document.querySelectorAll('[role="radiogroup"] label').forEach((label) => {
        const checked = label.querySelector('input').checked;
        label.classList.toggle('border-orange-600', checked);
        label.classList.toggle('bg-orange-50', checked);
        label.classList.toggle('border-slate-200', !checked);
      });
    }
    radios.forEach((r) => r.addEventListener('change', () => { paintJenis(); rebuildWizard(true); }));
    paintJenis();

    // ── Wizard langkah ──
    const wizardNav = $('wizard-nav');
    const wizardCount = $('wizard-count');
    const wizardTitle = $('wizard-title');
    const wizardBar = $('wizard-bar');
    const wizardFilled = $('wizard-filled');
    const wizardTotal = $('wizard-total');
    const btnPrev = $('btn-prev');
    const btnNext = $('btn-next');
    let wizardSteps = [];
    let wizardIndex = 0;

    function wizardBlocks() {
      const blocks = [];
      const push = (el, title) => { if (el && !blocks.some((b) => b.el === el)) blocks.push({ el, title }); };
      const jenisCard = document.querySelector('[role="radiogroup"]');
      push(jenisCard ? jenisCard.closest('.card') : null, 'Jenis survey');
      const mapEl = $('map');
      push(mapEl ? mapEl.closest('.card') : null, 'Lokasi & titik peta');
      push($('info-survei'), 'Informasi survei');
      const activeGroup = groups.find((g) => !g.classList.contains('hidden'));
      if (activeGroup) {
        Array.from(activeGroup.children).forEach((child, i) => {
          if (child.classList && child.classList.contains('hidden')) return;
          const h = child.querySelector('h3');
          push(child, h ? h.textContent.trim() : `Detail ${i + 1}`);
        });
      }
      const lampInput = document.querySelector('.lampiran-input:not(:disabled)');
      const lampCard = lampInput ? lampInput.closest('.card') : document.querySelector('.lampiran-input');
      push(lampCard ? lampCard.closest('.card') : lampCard, 'Lampiran');
      return blocks.filter((b) => b.el);
    }

    function wizardFields(root) {
      const scope = root || form;
      return Array.from(scope.querySelectorAll('input, select, textarea')).filter((el) => {
        if (el.disabled) return false;
        if (el.type === 'hidden' || el.type === 'submit' || el.type === 'button') return false;
        if (el.type === 'radio') return false;
        if (el.closest('.hidden')) return false;
        return true;
      });
    }

    function paintProgress() {
      const fields = wizardFields(null);
      let filled = 0;
      fields.forEach((el) => {
        if (el.type === 'checkbox') { if (el.checked) filled++; return; }
        if (el.type === 'file') { if (el.files && el.files.length > 0) filled++; return; }
        if ((el.value || '').trim() !== '') filled++;
      });
      const radioDone = !!form.querySelector('.jenis-radio:checked');
      const total = fields.length + 1;
      wizardTotal.textContent = String(total);
      wizardFilled.textContent = String(filled + (radioDone ? 1 : 0));
      const pct = total ? Math.round(((filled + (radioDone ? 1 : 0)) / total) * 100) : 0;
      wizardBar.style.width = pct + '%';
    }

    function showStep(i, scroll) {
      if (wizardSteps.length === 0) return;
      wizardIndex = Math.max(0, Math.min(i, wizardSteps.length - 1));
      wizardSteps.forEach((s, k) => s.el.classList.toggle('hidden', k !== wizardIndex));
      const cur = wizardSteps[wizardIndex];
      wizardCount.textContent = `${wizardIndex + 1}/${wizardSteps.length}`;
      wizardTitle.textContent = cur.title;
      btnPrev.disabled = wizardIndex === 0;
      btnPrev.classList.toggle('opacity-40', wizardIndex === 0);
      btnNext.innerHTML = wizardIndex === wizardSteps.length - 1
        ? 'Simpan <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>'
        : 'Lanjut <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>';
      paintProgress();
      try {
        if (map && cur.el.contains($('map'))) {
          setTimeout(() => { try { map.invalidateSize(); } catch (e) {} }, 100);
        }
      } catch (e) { /* peta belum init */ }
      if (scroll !== false) {
        wizardNav.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    function rebuildWizard(keepPosition) {
      const prevTitle = wizardSteps[wizardIndex] ? wizardSteps[wizardIndex].title : '';
      wizardSteps = wizardBlocks();
      if (keepPosition && prevTitle) {
        const at = wizardSteps.findIndex((s) => s.title === prevTitle);
        wizardIndex = at >= 0 ? at : 0;
      } else if (!keepPosition) {
        wizardIndex = 0;
      }
      wizardIndex = Math.max(0, Math.min(wizardIndex, Math.max(0, wizardSteps.length - 1)));
      showStep(wizardIndex, false);
    }

    function validateStep(stepEl) {
      const reqs = Array.from(stepEl.querySelectorAll('[required]')).filter((el) => !el.disabled && !el.closest('.hidden'));
      for (const el of reqs) {
        const empty = el.type === 'checkbox' ? !el.checked : (el.value || '').trim() === '';
        if (empty) {
          if (typeof el.reportValidity === 'function') el.reportValidity();
          el.focus({ preventScroll: false });
          return false;
        }
      }
      return true;
    }

    const KOORD_PAIRS = [
      ['latitude', 'longitude'],
      ['broncaptering_lat', 'broncaptering_lng'],
      ['reservoir_lat', 'reservoir_lng'],
      ['sumur_lat', 'sumur_lng'],
      ['ku1_lat', 'ku1_lng'],
      ['ku2_lat', 'ku2_lng'],
      ['mck_lat', 'mck_lng'],
    ];
    // Batas kasar Kabupaten Cianjur (peringatan saja, tidak memblokir)
    const CJ = { latMin: -7.6, latMax: -6.3, lngMin: 106.8, lngMax: 107.8 };

    function cekKoordinat() {
      const pairs = [];
      KOORD_PAIRS.forEach(([a, b]) => {
        const la = (($ (a) || {}).value || '').trim();
        const ln = (($ (b) || {}).value || '').trim();
        if (la !== '' && ln !== '') pairs.push({ a, la: parseFloat(la), ln: parseFloat(ln) });
      });
      if (pairs.length === 0) return { ok: false, outside: [] };
      const outside = pairs.filter((p) => !Number.isFinite(p.la) || !Number.isFinite(p.ln)
        || p.la < CJ.latMin || p.la > CJ.latMax || p.ln < CJ.lngMin || p.ln > CJ.lngMax);
      return { ok: true, outside };
    }

    btnPrev.addEventListener('click', () => showStep(wizardIndex - 1));
    btnNext.addEventListener('click', () => {
      if (wizardIndex < wizardSteps.length - 1) {
        if (!validateStep(wizardSteps[wizardIndex].el)) return;
        saveWip();
        showStep(wizardIndex + 1);
        return;
      }
      const cek = cekKoordinat();
      if (!cek.ok) {
        notify('Isi minimal satu titik koordinat: tandai peta utama (bagian Lokasi) atau isi koordinat tapak.');
        const mapStep = wizardSteps.findIndex((s) => s.el.contains($('map')));
        showStep(mapStep >= 0 ? mapStep : 0);
        return;
      }
      if (cek.outside.length > 0) {
        const ok = confirm('Ada titik di luar wilayah Kabupaten Cianjur. Tetap simpan?');
        if (!ok) return;
      }
      try { localStorage.removeItem(WIP_KEY); } catch (e) {}
      form.requestSubmit();
    });

    // ── Simpan otomatis (WIP) ke localStorage ──
    const WIP_KEY = 'esurvey-wip-v1';
    let wipTimer = null;
    function collectWip() {
      const values = {};
      wizardFields(null).forEach((el) => {
        if (!el.name || el.type === 'file') return;
        if (el.type === 'checkbox') { values[el.name] = el.checked ? '1' : ''; return; }
        if (el.type === 'radio') { if (el.checked) values[el.name] = el.value; return; }
        values[el.name] = el.value;
      });
      return { savedAt: new Date().toISOString(), values };
    }
    function saveWip() {
      try { localStorage.setItem(WIP_KEY, JSON.stringify(collectWip())); } catch (e) {}
    }
    function scheduleWip() {
      clearTimeout(wipTimer);
      wipTimer = setTimeout(() => { saveWip(); paintProgress(); }, 600);
    }
    form.addEventListener('input', scheduleWip);
    form.addEventListener('change', () => { saveWip(); paintProgress(); });

    (function restoreWip() {
      if (form.dataset.wasPost === '1') return;
      let wip = null;
      try { wip = JSON.parse(localStorage.getItem(WIP_KEY) || 'null'); } catch (e) {}
      if (!wip || !wip.values || Object.keys(wip.values).length === 0) return;
      const box = $('wizard-restore');
      box.classList.remove('hidden');
      $('wizard-restore-yes').addEventListener('click', () => {
        Object.entries(wip.values).forEach(([name, val]) => {
          const els = form.querySelectorAll(`[name="${CSS.escape(name)}"]`);
          els.forEach((el) => {
            if (el.disabled) return;
            if (el.type === 'checkbox') el.checked = val === '1';
            else if (el.type === 'radio') el.checked = el.value === val;
            else if (el.tagName === 'SELECT' || el.tagName === 'TEXTAREA' || el.tagName === 'INPUT') el.value = val;
          });
        });
        paintJenis();
        rebuildWizard(false);
        try {
          const kec = form.querySelector('#kecamatan_id');
          if (kec && kec.value && typeof loadDesa === 'function') {
            loadDesa(kec.value, wip.values.desa_id || '');
          }
        } catch (e) {}
        box.classList.add('hidden');
      });
      $('wizard-restore-no').addEventListener('click', () => {
        try { localStorage.removeItem(WIP_KEY); } catch (e) {}
        box.classList.add('hidden');
      });
    })();

    rebuildWizard(false);
    if (form.dataset.goto === 'map') {
      const at = wizardSteps.findIndex((s) => s.el.contains($('map')));
      if (at >= 0) showStep(at, false);
    }

    // ── Salin koordinat peta utama → broncaptering / reservoir ──
    // Penanda apakah pin peta utama sudah disentuh user (klik/geser/GPS/ketik).
    // Tanpa ini, marker default (tengah Cianjur) bisa tersalin diam-diam.
    let petaDisentuh = false;
    const tandaiPetaDisentuh = () => { petaDisentuh = true; };
    function koordinatPetaUtama() {
      const la = (latInput.value || '').trim();
      const ln = (lngInput.value || '').trim();
      if (la !== '' && ln !== '') return { lat: la, lng: ln };
      if (petaDisentuh && marker && typeof marker.getLatLng === 'function') {
        try {
          const p = marker.getLatLng();
          if (Number.isFinite(p.lat) && Number.isFinite(p.lng)) {
            return { lat: p.lat.toFixed(6), lng: p.lng.toFixed(6) };
          }
        } catch { /* abaikan */ }
      }
      return null;
    }
    document.querySelectorAll('.btn-salin-koord').forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.dataset.target || 'broncaptering';
        const c = koordinatPetaUtama();
        const laEl = $(`${target}_lat`);
        const lnEl = $(`${target}_lng`);
        if (!c || !laEl || !lnEl) {
          notify('Tandai dulu titik di peta utama (bagian 2. Lokasi) atau pakai tombol Pakai GPS saya.');
          return;
        }
        laEl.value = c.lat;
        lnEl.value = c.lng;
        const orig = btn.textContent;
        btn.textContent = 'Tersalin ✓';
        setTimeout(() => { btn.textContent = orig; }, 1500);
      });
    });

    // ── Elevasi otomatis (DEM online; butuh internet) ──
    async function fetchElevasiDEM(lat, lng) {
      const url = 'https://api.opentopodata.org/v1/mapzen?locations='
        + encodeURIComponent(lat + ',' + lng);
      const res = await fetch(url);
      if (!res.ok) throw new Error('HTTP ' + res.status);
      const data = await res.json().catch(() => null);
      const el = data && data.results && data.results[0] && data.results[0].elevation;
      if (typeof el !== 'number' || !Number.isFinite(el)) throw new Error('hasil kosong');
      return Math.round(el * 10) / 10;
    }
    function koordinatTapak(target) {
      const laEl = $(target + '_lat');
      const lnEl = $(target + '_lng');
      const la = ((laEl && laEl.value) || '').trim();
      const ln = ((lnEl && lnEl.value) || '').trim();
      if (la !== '' && ln !== '') return { lat: la, lng: ln };
      return koordinatPetaUtama();
    }
    document.querySelectorAll('.btn-elev-auto').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const target = btn.dataset.target || 'broncaptering';
        const elInput = $(target + '_elevasi');
        if (!elInput) return;
        const c = koordinatTapak(target);
        if (!c) {
          notify('Isi dulu lat/long tapak ini (atau tandai peta utama), lalu tekan Auto.');
          return;
        }
        const orig = btn.textContent;
        btn.disabled = true;
        btn.textContent = '…';
        try {
          elInput.value = await fetchElevasiDEM(c.lat, c.lng);
        } catch (e) {
          notify('Gagal mengambil elevasi otomatis (perlu internet). Isi manual.');
        } finally {
          btn.disabled = false;
          btn.textContent = orig;
        }
      });
    });

    // ── Wilayah: kecamatan → desa ──
    const kecSel = $('kecamatan_id');
    const desaSel = $('desa_id');
    const prevKec = kecSel.dataset.prev || '';
    const prevDesa = desaSel.dataset.prev || '';
    async function loadKecamatan() {
      try {
        const res = await fetch('/api/wilayah/kecamatan');
        const data = await res.json();
        const list = Array.isArray(data) ? data : (data.data ?? []);
        kecSel.innerHTML = '<option value="">— Pilih kecamatan —</option>';
        list.forEach((w) => {
          const opt = document.createElement('option');
          opt.value = String(w.id);
          opt.textContent = w.nama ?? w.nama_kecamatan ?? w.n_kec ?? ('#' + w.id);
          if (prevKec && String(w.id) === prevKec) opt.selected = true;
          kecSel.appendChild(opt);
        });
        if (prevKec) await loadDesa(prevKec, prevDesa);
      } catch {
        kecSel.innerHTML = '<option value="">Gagal memuat (offline?)</option>';
      }
    }
    async function loadDesa(kecId, selected) {
      desaSel.innerHTML = '<option value="">— Memuat… —</option>';
      if (!kecId) { desaSel.innerHTML = '<option value="">— Pilih kecamatan dulu —</option>'; return; }
      try {
        const res = await fetch('/api/wilayah/desa?kecamatan_id=' + encodeURIComponent(kecId));
        const data = await res.json();
        const list = Array.isArray(data) ? data : (data.data ?? []);
        desaSel.innerHTML = '<option value="">— Pilih desa —</option>';
        list.forEach((w) => {
          const opt = document.createElement('option');
          opt.value = String(w.id);
          opt.textContent = w.nama ?? w.nama_desa ?? w.n_desa ?? ('#' + w.id);
          if (selected && String(w.id) === selected) opt.selected = true;
          desaSel.appendChild(opt);
        });
      } catch {
        desaSel.innerHTML = '<option value="">Gagal memuat</option>';
      }
    }
    kecSel.addEventListener('change', () => loadDesa(kecSel.value, ''));
    loadKecamatan();

    // ── Peta Leaflet ──
    const latInput = $('latitude');
    const lngInput = $('longitude');
    let map = null, marker = null;
    function initMap() {
      if (typeof window.L === 'undefined') {
        setTimeout(initMap, 300);
        return;
      }
      const lat0 = parseFloat(latInput.value) || -6.819;
      const lng0 = parseFloat(lngInput.value) || 107.141;
      map = window.L.map('map').setView([lat0, lng0], 12);
      window.L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; OpenStreetMap',
      }).addTo(map);
      marker = window.L.marker([lat0, lng0], { draggable: true }).addTo(map);
      marker.on('dragend', () => {
        const p = marker.getLatLng();
        latInput.value = p.lat.toFixed(6);
        lngInput.value = p.lng.toFixed(6);
        tandaiPetaDisentuh();
      });
      map.on('click', (e) => {
        marker.setLatLng(e.latlng);
        latInput.value = e.latlng.lat.toFixed(6);
        lngInput.value = e.latlng.lng.toFixed(6);
        tandaiPetaDisentuh();
      });
      const syncFromInputs = () => {
        const la = parseFloat(latInput.value), ln = parseFloat(lngInput.value);
        if (Number.isFinite(la) && Number.isFinite(ln)) {
          marker.setLatLng([la, ln]);
          map.setView([la, ln], Math.max(map.getZoom(), 14));
          tandaiPetaDisentuh();
        }
      };
      latInput.addEventListener('change', syncFromInputs);
      lngInput.addEventListener('change', syncFromInputs);
      setTimeout(() => map.invalidateSize(), 400);
    }
    initMap();
    $('btn-gps').addEventListener('click', () => {
      if (!navigator.geolocation) { notify('GPS tidak tersedia di perangkat ini.'); return; }
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          const la = pos.coords.latitude.toFixed(6);
          const ln = pos.coords.longitude.toFixed(6);
          latInput.value = la; lngInput.value = ln;
          tandaiPetaDisentuh();
          if (map && marker) {
            marker.setLatLng([parseFloat(la), parseFloat(ln)]);
            map.setView([parseFloat(la), parseFloat(ln)], 16);
          }
        },
        () => notify('Gagal membaca GPS. Pastikan izin lokasi diberikan.'),
        { enableHighAccuracy: true, timeout: 15000 },
      );
    });

    // ── Preview lampiran per butir ──
    function isImageFile(f) {
      if (f.type) return f.type.startsWith('image/');
      return /\.(jpe?g|png|gif|webp|bmp)$/i.test(f.name || '');
    }
    document.querySelectorAll('.lampiran-input').forEach((input) => {
      const kat = input.dataset.kategori || '';
      const box = document.querySelector(`[data-preview="${kat}"]`);
      input.addEventListener('change', () => {
        if (!box) return;
        box.innerHTML = '';
        Array.from(input.files || []).slice(0, 10).forEach((f) => {
          if (isImageFile(f)) {
            const img = document.createElement('img');
            img.src = URL.createObjectURL(f);
            img.className = 'h-20 w-full rounded-lg border object-cover';
            box.appendChild(img);
          } else {
            const chip = document.createElement('div');
            chip.className = 'truncate rounded-lg border bg-slate-50 p-2 text-xs font-medium text-slate-600';
            chip.textContent = f.name || 'berkas';
            chip.title = f.name || '';
            box.appendChild(chip);
          }
        });
      });
    });

    // ── Draft offline ──
    function collectLampiran() {
      const out = [];
      document.querySelectorAll('.lampiran-input').forEach((input) => {
        const kat = input.dataset.kategori || '';
        Array.from(input.files || []).forEach((f) => {
          if (f && f.size > 0) out.push({ file: f, kategori: kat });
        });
      });
      return out;
    }

    // ── Draft offline ──
    function collectPayload() {
      const fd = new FormData(form);
      const payload = {};
      for (const [k, v] of fd.entries()) {
        if (typeof v !== 'string') continue;
        if (k === 'foto') continue;
        if (k in payload) continue; // grup detail nonaktif ikut terkirim disabled=false? hanya yg aktif
        payload[k] = v;
      }
      return payload;
    }
    $('btn-draft').addEventListener('click', async () => {
      try {
        const payload = collectPayload();
        if (!payload.nama_lokasi) { notify('Isi nama lokasi dulu sebelum menyimpan draft.'); return; }
        const files = collectLampiran();
        const id = await saveDraft(payload, files);
        notify('Draft tersimpan di perangkat (' + id + '). Buka menu Draft untuk sinkronisasi.', 'ok');
        window.location.href = '/draft';
      } catch (e) {
        notify('Gagal menyimpan draft: ' + (e.message || e));
      }
    });

    // Jika submit gagal karena offline → tawarkan simpan draft
    form.addEventListener('submit', () => {
      if (!navigator.onLine) {
        // Biarkan browser mencoba; halaman draft tersedia via nav.
      }
    });
  </script>
